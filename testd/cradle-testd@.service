[Unit]
Description=cradle tier-2 test runner for %i
# every request can start it: a burst must not trip the default 5 starts in
# 10 s (the path unit would then stop for good), a crash loop still stops
StartLimitIntervalSec=60
StartLimitBurst=30

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=DOCKER_HOST=unix://%t/podman/podman.sock
ExecStart=@CRADLE_ROOT@/bin/cradle-testd %i
